# ==============================================================================
# Modelo de variáveis de ambiente - Nuvem-Privada
# Este arquivo É seguro para versionar (não contém segredos reais).
#
# Como usar:
#   1. cp .env.example .env
#   2. Preencha o .env com valores reais/fortes
#   3. O .env nunca deve ser commitado (já está no .gitignore)
# ==============================================================================

# --- Credenciais do MariaDB ---
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_PASSWORD=troque-esta-senha-de-usuario
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# --- Credencial do Redis ---
REDIS_PASSWORD=troque-esta-senha-do-redis
